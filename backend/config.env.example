#
# Config local para runtime y benchmarking
# Marca "NECESARIO" = debes completar ese valor para usar ese provider.
#

# -----------------------------
# Providers activos por defecto
# -----------------------------
LLM_PROVIDER=gemini
STT_PROVIDER=elevenlabs
TTS_PROVIDER=elevenlabs

# -----------------------------
# Opciones compartidas
# -----------------------------
LLM_SYSTEM_PROMPT=Eres un asistente virtual para generar horarios, breve y claro.
BENCHMARK_OUTPUT_DIR=backend/benchmarks/outputs
BENCHMARK_DEVICE=cpu
BENCHMARK_REPETITIONS=5

# -----------------------------
# Gemini
# -----------------------------
LLM_API_KEY=NECESARIO
LLM_MODEL=gemini-3.1-flash-lite
GEMINI_STT_MODEL=gemini-3.5-flash
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore
# Benchmark LLM con Gemini:
# - gemini-3.1-flash-lite
# - gemini-2.5-flash

# -----------------------------
# Groq
# -----------------------------
GROQ_API_KEY=NECESARIO
GROQ_MODEL=llama-3.1-8b-instant
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_BASE_URL=https://api.groq.com
# Benchmark LLM con Groq:
# - llama-3.1-8b-instant
# - qwen/qwen3-32b

# -----------------------------
# Ollama
# -----------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3
# Modelo local instalado actualmente:
# - gemma3

# -----------------------------
# ElevenLabs STT / TTS
# -----------------------------
ELEVENLABS_API_KEY=NECESARIO
STT_MODEL=scribe_v2
TTS_MODEL=eleven_multilingual_v2
TTS_VOICE_ID=NECESARIO
TTS_OUTPUT_FORMAT=mp3_44100_128
# Benchmark TTS con ElevenLabs:
# - eleven_multilingual_v2
# - eleven_flash_v2_5

# -----------------------------
# Whisper local
# -----------------------------
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
FFMPEG_BINARY=C:\Users\deanv\AppData\Local\Microsoft\WinGet\Packages\Gyan.FFmpeg.Essentials_Microsoft.Winget.Source_8wekyb3d8bbwe\ffmpeg-8.1.1-essentials_build\bin\ffmpeg.exe

# -----------------------------
# Moonshine local
# -----------------------------
MOONSHINE_MODEL=es

# -----------------------------
# Piper TTS
# -----------------------------
PIPER_BINARY=C:\Users\deanv\OneDrive\Escritorio\Tilapez\ProyectoAgentesVirtuales\backend\.venv\Scripts\piper.exe
PIPER_MODEL_PATH=C:\Users\deanv\OneDrive\Escritorio\Tilapez\ProyectoAgentesVirtuales\backend\models\piper\es_MX-ald-medium.onnx
PIPER_CONFIG_PATH=C:\Users\deanv\OneDrive\Escritorio\Tilapez\ProyectoAgentesVirtuales\backend\models\piper\es_MX-ald-medium.onnx.json
PIPER_SPEAKER_ID=0

# -----------------------------
# Kokoro TTS
# -----------------------------
# En Python 3.13 usa fallback con kokoro-onnx
KOKORO_MODEL_PATH=C:\Users\deanv\OneDrive\Escritorio\Tilapez\ProyectoAgentesVirtuales\backend\models\kokoro\kokoro-v1.0.onnx
KOKORO_VOICES_PATH=C:\Users\deanv\OneDrive\Escritorio\Tilapez\ProyectoAgentesVirtuales\backend\models\kokoro\voices-v1.0.bin
KOKORO_VOICE=af_bella
KOKORO_DEVICE=cpu
KOKORO_LANGUAGE=es

# -----------------------------
# Retries
# -----------------------------
LLM_RETRIES=2
LLM_RETRY_DELAY=0.4
STT_RETRIES=2
STT_RETRY_DELAY=0.3
TTS_RETRIES=1
TTS_RETRY_DELAY=0.2

# -----------------------------
# Debug
# -----------------------------
BACKEND_DEBUG_LOGS=false
